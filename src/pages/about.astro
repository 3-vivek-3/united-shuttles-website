---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";
import { getEntry, render } from "astro:content";
import Divider from "../components/Divider.astro";

const page = await getEntry("pages", "about");

if (!page) {
    throw new Error("Missing content file");
}

const { Content } = await render(page);
const LANGUAGE = "en";
const PAGE_TITLE = "About";
---

<Layout
    title={`${PAGE_TITLE} - ${SITE_CONFIG.title}`}
    showCopyright={true}
    compactFooter={true}
    language={LANGUAGE}
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <h1
            class="text-3xl font-bold text-center uppercase text-gray-600 dark:text-gray-400 mb-6"
        >
            {PAGE_TITLE}
        </h1>

        <Divider />

        <div
            class="flex flex-col items-center text-gray-600 dark:text-gray-400 mt-8"
        >
            <article class="prose dark:prose-invert">
                <Content />
            </article>
        </div>
    </div>
</Layout>
