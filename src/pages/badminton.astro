---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";
import { getEntry, render } from "astro:content";
import Divider from '../components/Divider.astro';

const page = await getEntry("pages", "badminton");

if (!page) {
    throw new Error("Missing content file: src/content/pages/about.md");
}

const { Content } = await render(page);
---

<Layout
    title={`About - ${SITE_CONFIG.title}`}
    showCopyright={true}
    compactFooter={true}
>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <h2
            class="text-3xl font-bold text-center uppercase text-gray-600 dark:text-gray-400 mb-6"
        >
            Badminton
        </h2>

        <Divider />

        <div
            class="flex flex-col items-center text-gray-600 dark:text-gray-400 mt-8"
        >
            <article class="prose dark:prose-invert">
                <Content />
            </article>
        </div>
    </div>
</Layout>