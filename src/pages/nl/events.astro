---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONFIG } from "../../config";
import { getEntry, render } from "astro:content";
import Divider from "../../components/Divider.astro";

const page = await getEntry("pages", "nl/events");

if (!page) {
    throw new Error("Missing content file");
}

const { Content } = await render(page);
const LANGUAGE = "nl";
const PAGE_TITLE = "Evenementen";
---

<Layout
    title={`${PAGE_TITLE} - ${SITE_CONFIG.title}`}
    showCopyright={true}
    compactFooter={true}
    language={LANGUAGE}
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <article class="prose">
        <h1 class="text-center uppercase">
            {PAGE_TITLE}
        </h1>

        <Divider />

        <div class="mt-4">
            <Content />
        </div>
    </article>
    </div>
</Layout>
