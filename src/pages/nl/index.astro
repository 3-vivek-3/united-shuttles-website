---
import Layout from "../../layouts/Layout.astro";
import { SITE_CONFIG } from "../../config";

const LANGUAGE = "nl";
---

<Layout
	title={`Home - ${SITE_CONFIG.title}`}
	showCopyright={true}
	compactFooter={true}
	centerInViewport={true}
	language={LANGUAGE}>
	<div class="w-full text-center px-4 sm:px-6 lg:px-8">
		<div class="mb-8">
			<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
				Welkom bij United Shuttles
			</h1>
			<p class="text-xl sm:text-2xl">
				Onze website is momenteel in ontwikkeling :)
			</p>
		</div>
	</div>
</Layout>
