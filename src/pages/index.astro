---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";

const LANGUAGE = "en";
---

<Layout
    title={`Home - ${SITE_CONFIG.title}`}
    showCopyright={true}
    compactFooter={true}
    centerInViewport={true}
    language={LANGUAGE}
>
    <div class="w-full text-center px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1
                class="prose text-4xl sm:text-5xl md:text-6xl font-bold mb-4"
            >
                Welcome to United Shuttles
            </h1>
            <p class="prose text-xl sm:text-2xl">
                Our website is currently under development :)
            </p>
        </div>
    </div>
</Layout>
