---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";

const LANGUAGE = "en";
---

<Layout
	title={`404 - ${SITE_CONFIG.title}`}
	showCopyright={true}
	compactFooter={true}
	centerInViewport={true}
	language={LANGUAGE}>
	<div class="w-full text-center px-4 sm:px-6 lg:px-8">
		<div class="mb-8">
			<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
				404
			</h1>
		</div>
	</div>
</Layout>
