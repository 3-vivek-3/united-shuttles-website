---
const base = import.meta.env.BASE_URL;

interface Props {
    language?: string;
    class?: string;
}

const { language = "en", class: className = "" } = Astro.props;

const normalizedBase = base.endsWith("/") ? base : `${base}/`;
let currentPath = Astro.url.pathname;

if (normalizedBase !== "/" && currentPath.startsWith(normalizedBase)) {
    currentPath = `/${currentPath.slice(normalizedBase.length)}`;
}

currentPath = currentPath.replace(/\/$/, "") || "/";

const alternatePath =
    language === "nl"
        ? currentPath.replace(/^\/nl(?=\/|$)/, "") || "/"
        : currentPath === "/"
          ? "/nl"
          : `/nl${currentPath}`;

const switchLabel = language === "nl" ? "EN" : "NL";
const switchHref = `${base}${alternatePath.replace(/^\//, "")}`;
---

<a href={switchHref} class={className}>
    {switchLabel}
</a>
